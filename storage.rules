rules_version = '2';

// Applicants aren't logged in, so uploads are gated on Firebase Anonymous Auth
// (signed in client-side right before upload — see src/lib/firebase/client.ts and
// SubmissionWizard.tsx) rather than a real account. This is a blunt, per-file
// backstop only: Storage rules can't see a whole upload batch at once, so the
// authoritative "10MB total across all files" check happens afterwards, server-side,
// in /api/pitch2product via the Admin SDK (which re-fetches real file metadata and
// deletes anything that fails the aggregate check). This layer just blocks the
// obvious cases — wrong file type, a single file already over the cap — before any
// bytes are even accepted.
service firebase.storage {
  match /b/{bucket}/o {
    match /pitch2product/{uid}/{fileName} {
      allow read: if false;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && (
          request.resource.contentType in [
            'application/pdf',
            'application/vnd.ms-powerpoint',
            'application/vnd.openxmlformats-officedocument.presentationml.presentation',
            'application/msword',
            'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
            'application/vnd.ms-excel',
            'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
            'image/png',
            'image/jpeg',
            'application/octet-stream'
          ]
          || request.resource.contentType == ''
        );
    }
  }
}
